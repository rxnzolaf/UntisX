<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/linearlayout_widget_listitem_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="6dp"
    android:background="#1E1E4A"
    android:layout_marginBottom="4dp">

    <View
        android:id="@+id/view_widget_color_bar"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="#4F6BFF"
        android:layout_marginEnd="8dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textview_listitem_line1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F3F4FF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/textview_listitem_line2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#A5A8D6"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/textview_widget_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:visibility="gone"
        android:layout_marginStart="6dp" />
</LinearLayout>
